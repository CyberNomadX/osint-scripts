#!/usr/bin/env bash
# subscan - Subdomain enumeration using subfinder and amass
# Author: CyberNomadX
# Usage: subscan [options] <domain>

# Colors
RED=$(tput setaf 1)
GREEN=$(tput setaf 2)
YELLOW=$(tput setaf 3)
NC=$(tput sgr0)

usage() {
    echo "Subdomain Enumeration Script"
    echo ""
    echo "Usage: $0 [options] <domain>"
    echo "Example: $0 example.com"
    echo ""
    echo "Options:"
    echo "  -h, --help    Show this help message"
    echo "  -f, --filter  Filter for interesting results (WIP)"
    exit 0
}

filter=false

# Parse flags FIRST — domain is positional, not $1 before flags are consumed
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)  usage ;;
        -f|--filter) filter=true; shift ;;
        --) shift; break ;;
        -*) echo "${RED}❌ Unknown option: $1${NC}"; exit 1 ;;
        *)  break ;;  # First non-flag argument is the domain
    esac
done

domain="${1:-}"

if [[ -z "$domain" ]]; then
    echo "${RED}❌ Error: No domain provided.${NC}"
    echo "⚠️  Usage: $0 [options] <domain>"
    exit 1
fi

if [[ ! "$domain" =~ ^[a-zA-Z0-9.-]+$ ]]; then
    echo "${RED}❌ Error: Invalid domain format.${NC}"
    exit 1
fi

output_file="subdomains_${domain}.txt"
tmp_dir=$(mktemp -d)
trap 'rm -rf "$tmp_dir"' EXIT

# Check dependencies
check_dep() {
    if command -v "$1" &>/dev/null; then
        echo "${GREEN}✅ $1 is installed.${NC}"
    else
        echo "${RED}❌ $1 is not installed.${NC}"
        echo "${YELLOW}Please install $1 and try again.${NC}"
        exit 1
    fi
}

check_dep subfinder
check_dep amass

# Run both tools in parallel (addresses the TODO)
echo "${YELLOW}===>${NC} Running Subfinder and Amass in parallel on ${domain}..."
echo "⏳ Patience... (amass may take a while)"

subfinder -d "$domain" -o "${tmp_dir}/subfinder_results.txt" 2>/dev/null &
PID_SUBFINDER=$!

amass enum -passive -d "$domain" -o "${tmp_dir}/amass_results.txt" 2>/dev/null &
PID_AMASS=$!

wait $PID_SUBFINDER; SUBFINDER_EXIT=$?
wait $PID_AMASS;    AMASS_EXIT=$?

[[ $SUBFINDER_EXIT -ne 0 ]] && echo "${YELLOW}⚠️  Subfinder finished with errors. Results may be incomplete.${NC}"
[[ $AMASS_EXIT    -ne 0 ]] && echo "${YELLOW}⚠️  Amass finished with errors. Results may be incomplete.${NC}"

# Merge and deduplicate — sort -u handles this correctly
echo "${YELLOW}===>${NC} Merging and deduplicating results..."
cat "${tmp_dir}/subfinder_results.txt" "${tmp_dir}/amass_results.txt" 2>/dev/null \
    | tr '[:upper:]' '[:lower:]' \
    | sort -u \
    > "$output_file"

COUNT=$(wc -l < "$output_file")
echo "${GREEN}✅ Enumeration complete.${NC} Found ${COUNT} unique subdomains. Results saved to ${output_file}"

# Copy to domains.txt so asaudit can pick them up directly
cp "$output_file" domains.txt
echo "${YELLOW}===>${NC} Copied results to domains.txt for use with asaudit."

echo "${YELLOW}===>${NC} Exiting..."